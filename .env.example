# 데이터베이스 (MySQL)
# Railway에서 제공받은 MySQL URL 입력
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT 세션 비밀키 (임의의 긴 문자열로 변경하세요)
JWT_SECRET=your-super-secret-key-change-this

# 관리자 등록 시 사용할 비밀키 (선택사항)
ADMIN_REGISTER_KEY=your-admin-key

# 파일 업로드 디렉토리 (기본값: uploads)
UPLOAD_DIR=uploads

# 서버 포트 (기본값: 3000)
PORT=3000
